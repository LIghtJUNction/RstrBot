{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RstrBot",
  "version": "0.1.3",
  "identifier": "org.rstrbot.desktop",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "RstrBot",
        "width": 760,
        "height": 680,
        "minWidth": 360,
        "minHeight": 480,
        "url": "index.html"
      }
    ],
    "security": {
      "capabilities": [
        "launcher"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A private workspace for conversations, tools and knowledge",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/rstrbot",
      "binaries/rstrbot-openai",
      "binaries/rstrbot-diagnostic",
      "binaries/rstrbot-webhook"
    ],
    "resources": {
      "resources/web/": "web/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
